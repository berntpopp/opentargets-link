# opentargets-link configuration
#
# Copy to .env and edit. All variables use the OPENTARGETS_LINK_ prefix.
# Nested settings use a double-underscore delimiter (e.g. OPENTARGETS_LINK_OPENTARGETS__BASE_URL).

# --- Server ---
OPENTARGETS_LINK_HOST=127.0.0.1
OPENTARGETS_LINK_ALLOW_PUBLIC_BIND=false
OPENTARGETS_LINK_PORT=8000
# transport: unified | http | stdio
OPENTARGETS_LINK_TRANSPORT=unified
OPENTARGETS_LINK_MCP_PATH=/mcp
OPENTARGETS_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
OPENTARGETS_LINK_ALLOWED_ORIGINS='[]'
# Comma-separated list of allowed CORS origins (empty = none)
OPENTARGETS_LINK_CORS_ORIGINS=
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
OPENTARGETS_LINK_LOG_LEVEL=INFO
# log_format: json | console
OPENTARGETS_LINK_LOG_FORMAT=console

# --- Open Targets upstream (nested: opentargets) ---
OPENTARGETS_LINK_OPENTARGETS__BASE_URL=https://api.platform.opentargets.org
OPENTARGETS_LINK_OPENTARGETS__REQUEST_TIMEOUT_S=20.0
# Politeness: Open Targets publishes no hard limit; 0.3 s spacing (~200/min) keeps it polite.
OPENTARGETS_LINK_OPENTARGETS__MIN_INTERVAL_S=0.3
OPENTARGETS_LINK_OPENTARGETS__DAILY_CAP=20000
OPENTARGETS_LINK_OPENTARGETS__MAX_WAIT_S=20.0
OPENTARGETS_LINK_OPENTARGETS__MAX_RETRIES=2
OPENTARGETS_LINK_OPENTARGETS__BACKOFF_BASE_S=2.0
OPENTARGETS_LINK_OPENTARGETS__MAX_RESPONSE_BYTES=16777216
# In-process response cache (no on-disk state)
OPENTARGETS_LINK_OPENTARGETS__CACHE_TTL_S=900
OPENTARGETS_LINK_OPENTARGETS__CACHE_MAXSIZE=512
